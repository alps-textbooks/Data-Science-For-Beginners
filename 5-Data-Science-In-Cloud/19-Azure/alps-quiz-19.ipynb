    "      </statement>\n",
    "    </choice>\n",
    "    <choice>\n",
    "      <statement>\n",
    "        <p>Automatically label the dataset</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "    <choice>\n",
    "      <statement>\n",
    "        <p>Better security of the model</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "  </choices>\n",
    "</exercise>"
