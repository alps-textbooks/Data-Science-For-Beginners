    "<exercise label=\"dsb-quiz-19-pre-3\">\n",
    "  <statement>\n",
    "    <p>What is AutoML?</p>\n",
    "  </statement>\n",
    "  <choices randomize=\"no\">\n",
    "    <choice>\n",
    "      <statement>\n",
    "        <p>A tool for automating the preprocessing of data</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "    <choice correct=\"yes\">\n",
    "      <statement>\n",
    "        <p>A tool for automating the deployment of models</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "    <choice>\n",
    "      <statement>\n",
    "        <p>All of the above</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "  </choices>\n",
    "</exercise>"
