    "format": "application/vnd.pretext+xml"
   },
   "source": [
    "<exercise label=\"dsb-quiz-01-pre-1\">\n",
    "  <statement>\n",
    "    <p>Why is the word <em>Science</em> in Data Science?</p>\n",
    "  </statement>\n",
    "  <choices randomize=\"no\">\n",
    "    <choice correct=\"yes\">\n",
    "      <statement>\n",
    "        <p>It uses scientific methods to analyze data</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "    <choice>\n",
    "      <statement>\n",
    "        <p>Only people with academic degrees can understand it</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "    <choice>\n",
    "      <statement>\n",
    "        <p>To make is sound cool</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "  </choices>\n",
    "</exercise>"
   ]
  },
