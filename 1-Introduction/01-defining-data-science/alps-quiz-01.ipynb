    "    </choice>\n",
    "    <choice>\n",
    "      <statement>\n",
    "        <p>Know some probability and statistics</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "    <choice correct=\"yes\">\n",
    "      <statement>\n",
    "        <p>All of the above</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "  </choices>\n",
    "</exercise>"
